<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗退出：140ms 轻微上移回缩，使用与页面相同的 v5 曲线；关闭动画时静态结束。 -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="140"
    android:interpolator="@interpolator/ui_standard">
    <alpha android:fromAlpha="1" android:toAlpha="0" />
    <scale
        android:fromXScale="1"
        android:toXScale="0.98"
        android:fromYScale="1"
        android:toYScale="0.98"
        android:pivotX="50%"
        android:pivotY="50%" />
    <translate android:fromYDelta="0" android:toYDelta="-2%" />
</set>
