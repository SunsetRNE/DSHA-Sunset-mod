<?xml version="1.0" encoding="utf-8"?>
<!--
  运行环境维护详情页（2026-10-31 重构，与部署胶囊面板同一风格）：标题 + 状态标签、说明、
  分段条 + 阶段列表、失败 / 未就绪说明框、底栏按钮。保留历史 id（extract_title / extract_status /
  extract_error / extract_bar / extract_progress / extract_retry / extract_enter /
  extract_emergency / extract_logs / extract_actions），设备审计会按 id 与字段读取。
  extract_bar 只在维护进行中可见；extract_progress 不再显示（阶段条由代码按阶段绘制）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shell_bg"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/extract_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/extract_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/extract_bar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:indeterminateTint="@color/shell_accent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/extract_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:includeFontPadding="false"
                    android:textColor="@color/shell_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/extract_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/extract_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/shell_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/extract_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/shell_text_secondary"
                android:textSize="13.5sp" />


            <!-- 方案 A：内容宽度足够时，左列阶段卡、右列失败/未就绪说明并排；无说明时右列隐藏，阶段卡占满。
                 页内不内嵌维护记录，完整记录走底栏“查看本次维护记录”。 -->
            <com.deepseekharness.app.ui.AdaptiveColumns
                android:id="@+id/extract_columns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/extract_stage_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/bg_onb_perm"
                    android:orientation="vertical"
                    android:padding="16dp">
    
                    <TextView
                        android:id="@+id/extract_stage_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/shell_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
    
                    <ProgressBar
                        android:id="@+id/extract_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="10dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/shell_accent"
                        android:visibility="gone" />
    
                    <FrameLayout
                        android:id="@+id/extract_segments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />
    
                    <FrameLayout
                        android:id="@+id/extract_stages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/extract_focus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/extract_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_onb_hint_bad"
                        android:lineSpacingExtra="3dp"
                        android:padding="12dp"
                        android:textColor="@color/shell_bad"
                        android:textIsSelectable="true"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.deepseekharness.app.ui.AdaptiveColumns>
        </LinearLayout>
    </ScrollView>

    <!-- 底栏（build249 起压缩）：主操作行 + 一行三个独立描边次要入口（方案 B）。
         主操作行竖屏为上下两行（主在上），宽屏 / 横屏由 ExtractActivity 改为并排（次左主右）。
         维护进行中主按钮换成不可点的进度面板 extract_busy，避免“浅底白字”的禁用按钮看不清。 -->
    <LinearLayout
        android:id="@+id/extract_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_onb_footer"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/extract_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/extract_retry"
                style="@style/ShellPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/extract_primary_height" />

            <LinearLayout
                android:id="@+id/extract_busy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_extract_busy"
                android:gravity="center"
                android:importantForAccessibility="yes"
                android:minHeight="@dimen/extract_primary_height"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:indeterminateTint="@color/shell_accent" />

                <TextView
                    android:id="@+id/extract_busy_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="@color/shell_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/extract_busy_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/shell_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/extract_enter"
                style="@style/ShellSecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="@dimen/touch_min" />
        </LinearLayout>

        <!-- 次要入口（方案 B）：三个独立描边小按钮，间距 8dp；强调项换告警 / 提醒描边与浅底。 -->
        <LinearLayout
            android:id="@+id/extract_links"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/extract_logs"
                style="@style/ExtractLinkButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/extract_copy_support"
                style="@style/ExtractLinkButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/extract_emergency"
                style="@style/ExtractLinkButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
