<?xml version="1.0" encoding="utf-8"?>
<!--
  运行环境维护详情页（2026-10-31 重构，与部署胶囊面板同一风格）：标题 + 状态标签、说明、
  分段条 + 阶段列表、失败 / 未就绪说明框、底栏按钮。保留历史 id（extract_title / extract_status /
  extract_detail / extract_error / extract_bar / extract_progress / extract_retry / extract_enter /
  extract_emergency / extract_logs / extract_actions），设备审计会按 id 与字段读取。
  extract_bar 只在维护进行中可见；extract_progress 不再显示（阶段条由代码按阶段绘制）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shell_bg"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/extract_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/extract_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/extract_bar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:indeterminateTint="@color/shell_accent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/extract_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:includeFontPadding="false"
                    android:textColor="@color/shell_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/extract_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/extract_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/shell_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/extract_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/shell_text_secondary"
                android:textSize="13.5sp" />

            <LinearLayout
                android:id="@+id/extract_stage_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_onb_perm"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/extract_stage_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/shell_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/extract_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/shell_accent"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/extract_segments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <FrameLayout
                    android:id="@+id/extract_stages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/extract_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_onb_hint_bad"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:textColor="@color/shell_bad"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/extract_detail_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:textColor="@color/shell_text_muted"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/extract_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_ui2_console"
                android:fontFamily="monospace"
                android:lineSpacingExtra="5dp"
                android:minHeight="96dp"
                android:padding="14dp"
                android:textColor="@color/ui2_log_text"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/extract_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_onb_footer"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/extract_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/extract_retry"
                style="@style/ShellPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/extract_enter"
                style="@style/ShellSecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/extract_logs"
                style="@style/ShellTextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/extract_emergency"
                style="@style/ShellTextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
