<?xml version='1.0' encoding='utf-8'?>
<!--
  启动主页（UI v5 方案 A）：顶部语境 → 大标题 + 说明 + 主操作（右侧插图，仅 ≥600dp）→
  三段就绪轨道（无卡片，上下分隔线）→ 快捷入口 / 启动日志（内容宽度 ≥760dp 时左右并排）。
  - 所有状态文案与可见性仍由 LaunchFragment 按真实运行状态写入；保留全部既有 id。
  - launch_activity 必须紧跟 launch_subtitle、位于 launch_actions 内（单测锁定）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/shell_bg">

  <ScrollView android:id="@+id/launch_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/shell_bg" android:fillViewport="true" android:overScrollMode="ifContentScrolls">

    <LinearLayout android:id="@+id/launch_sections" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/shell_launch_page_pad" android:paddingTop="@dimen/shell_launch_page_top" android:paddingEnd="@dimen/shell_launch_page_pad" android:paddingBottom="@dimen/shell_launch_page_bottom">

      <!-- 顶部语境：状态点 + 「本机工作台 · 状态」。 -->
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/launch_run_dot" style="@style/ShellLaunchDot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" android:text="@string/ui_status_dot" />
        <TextView android:id="@+id/launch_eyebrow" style="@style/ShellLaunchEyebrow" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" />
      </LinearLayout>

      <!-- Hero：左侧标题与操作，右侧插图（窄屏隐藏）。 -->
      <LinearLayout android:id="@+id/launch_hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">

        <LinearLayout android:id="@+id/launch_actions" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

          <TextView android:id="@+id/launch_run_state" style="@style/ShellLaunchTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:accessibilityLiveRegion="polite" android:text="@string/ui2_stopped" />

          <TextView android:id="@+id/launch_subtitle" style="@style/ShellLaunchDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/ui2_launch_hint" />

          <com.deepseekharness.app.ui.ShellActivityTrack android:id="@+id/launch_activity" android:layout_width="match_parent" android:layout_height="@dimen/shell_launch_activity_height" android:layout_marginTop="16dp" android:importantForAccessibility="no" />

          <TextView android:id="@+id/launch_status" style="@style/ShellLaunchMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:accessibilityLiveRegion="polite" android:text="" android:visibility="gone" />

          <!-- 主操作 + 轻量停止 / 重启；窄屏由 LaunchFragment 改为主操作独占一行。 -->
          <LinearLayout android:id="@+id/launch_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/launch_start" style="@style/ShellLaunchPrimary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="180dp" android:paddingStart="24dp" android:paddingEnd="24dp" android:text="@string/ui2_start" />
            <LinearLayout android:id="@+id/launch_quiet_controls" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:gravity="center_vertical" android:orientation="horizontal">
              <androidx.appcompat.widget.AppCompatButton android:id="@+id/launch_stop" style="@style/ShellLaunchQuiet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui2_stop" />
              <androidx.appcompat.widget.AppCompatButton android:id="@+id/launch_open" style="@style/ShellLaunchQuiet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="@string/ui2_restart" />
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>

        <!-- 原型 A 插图：旋转外环 + 品牌内核；纯装饰，不参与无障碍。 -->
        <FrameLayout android:id="@+id/launch_art" android:layout_width="116dp" android:layout_height="140dp" android:layout_marginStart="24dp" android:importantForAccessibility="noHideDescendants" android:visibility="gone">
          <View android:id="@+id/launch_art_ring" android:layout_width="98dp" android:layout_height="93dp" android:layout_gravity="center" android:background="@drawable/bg_launch_art_ring" android:rotation="13" />
          <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_gravity="center" android:background="@drawable/bg_launch_art_core">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_terminal" app:tint="@color/shell_accent" />
          </FrameLayout>
        </FrameLayout>
      </LinearLayout>

      <!-- 三段就绪轨道：运行环境 / 工作台 / 实际端口。无卡片，上下分隔线。 -->
      <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="@dimen/shell_launch_section_gap" android:background="@color/shell_line" />
      <LinearLayout android:id="@+id/launch_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

        <LinearLayout style="@style/ShellLaunchRailItem" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
          <FrameLayout android:layout_width="31dp" android:layout_height="31dp" android:background="@drawable/bg_launch_tile">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ic_ui2_box" app:tint="@color/shell_accent" />
          </FrameLayout>
          <TextView style="@style/ShellLaunchRailLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_environment" />
          <TextView android:id="@+id/launch_environment" style="@style/ShellLaunchRailValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_status_unavailable" />
        </LinearLayout>

        <LinearLayout style="@style/ShellLaunchRailItem" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
          <FrameLayout android:layout_width="31dp" android:layout_height="31dp" android:background="@drawable/bg_launch_tile">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ic_terminal" app:tint="@color/shell_accent" />
          </FrameLayout>
          <TextView style="@style/ShellLaunchRailLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_workspace" />
          <TextView android:id="@+id/launch_workbench" style="@style/ShellLaunchRailValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_status_unavailable" />
        </LinearLayout>

        <LinearLayout style="@style/ShellLaunchRailItem" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
          <FrameLayout android:layout_width="31dp" android:layout_height="31dp" android:background="@drawable/bg_launch_tile">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ic_ui_link" app:tint="@color/shell_accent" />
          </FrameLayout>
          <TextView style="@style/ShellLaunchRailLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_port" />
          <TextView android:id="@+id/launch_port" style="@style/ShellLaunchRailValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="@string/ui_status_unavailable" />
        </LinearLayout>
      </LinearLayout>
      <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/shell_line" />

      <!-- 下半区：快捷入口 | 启动日志；内容宽度 ≥760dp 时并排（AdaptiveColumns）。 -->
      <com.deepseekharness.app.ui.AdaptiveColumns android:id="@+id/launch_bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_launch_section_gap">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView android:id="@+id/launch_shortcuts_title" style="@style/ShellLaunchSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:minHeight="@dimen/shell_launch_pill_height" android:text="@string/ui2_shortcuts" />

          <LinearLayout android:id="@+id/launch_shortcuts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <TextView android:id="@+id/launch_terminal_row" style="@style/ShellLaunchRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_terminal" android:drawableEnd="@drawable/ic_ui2_chevron" android:drawablePadding="14dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/shell_line" />

            <TextView android:id="@+id/launch_environment_row" style="@style/ShellLaunchRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_ui2_box" android:drawableEnd="@drawable/ic_ui2_chevron" android:drawablePadding="14dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/shell_line" />

            <LinearLayout android:id="@+id/launch_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="@dimen/shell_launch_row_height" android:orientation="horizontal" android:paddingStart="4dp" android:paddingTop="10dp" android:paddingEnd="4dp" android:paddingBottom="10dp">
              <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_ui_link" app:tint="@color/shell_text_muted" />
              <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/ui2_address" android:textColor="@color/shell_text" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:includeFontPadding="false" android:text="@string/ui2_address_sub" android:textColor="@color/shell_text_muted" android:textSize="11sp" />
              </LinearLayout>
              <ImageView android:layout_width="16dp" android:layout_height="16dp" android:contentDescription="@null" android:src="@drawable/ic_ui2_chevron" app:tint="@color/shell_text_muted" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/shell_line" />
          </LinearLayout>
        </LinearLayout>

        <!-- 启动日志：复制 / 导出 / 跟随最新，以及原有安全启动与恢复入口。 -->
        <LinearLayout android:id="@+id/launch_log_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_launch_section_gap" android:orientation="vertical">

          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/ShellLaunchSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui2_logs" />
            <Button android:id="@+id/launch_copy_logs" style="@style/ShellLaunchPillButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" />
            <Button android:id="@+id/launch_download_logs" style="@style/ShellLaunchPillButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/ui_m0046" />
          </LinearLayout>

          <com.deepseekharness.app.ui.LogScrollView android:id="@+id/launch_log_scroll" android:layout_width="match_parent" android:layout_height="@dimen/shell_launch_log_height" android:layout_marginTop="10dp" android:background="@drawable/bg_shell_status" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
              <TextView android:id="@+id/lan_addr" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="" android:textColor="@color/shell_accent" android:textIsSelectable="true" android:textSize="11sp" android:visibility="gone" />
              <TextView android:id="@+id/launch_log" style="@style/ShellLaunchLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_m0025" />
            </LinearLayout>
          </com.deepseekharness.app.ui.LogScrollView>

          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/launch_follow_logs" style="@style/ShellLaunchPill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" />
            <TextView android:id="@+id/launch_latest_button" style="@style/ShellLaunchLatest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="" android:visibility="gone" />
          </LinearLayout>

          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/launch_safe" style="@style/ShellLaunchSecondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_m0007" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/launch_recovery" style="@style/ShellLaunchSecondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/shell_launch_control_gap" android:layout_weight="1" android:text="@string/ui_m0011" />
          </LinearLayout>
        </LinearLayout>
      </com.deepseekharness.app.ui.AdaptiveColumns>
    </LinearLayout>
  </ScrollView>

  <FrameLayout android:id="@+id/launch_web" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
    <FrameLayout android:id="@+id/launch_web_box" android:layout_width="match_parent" android:layout_height="match_parent" />
  </FrameLayout>
</FrameLayout>
