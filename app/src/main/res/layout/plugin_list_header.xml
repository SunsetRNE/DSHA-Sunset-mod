<?xml version="1.0" encoding="utf-8"?>
<!--
  插件页头部（UI v5）：页面标题 → 市场/已安装分段 → 社区入口 → 链接安装 → 已安装筛选卡片。
  保留 PluginFragment 使用的全部 id；真实插件状态仍由页面投影，不在这里伪造。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <TextView style="@style/ShellPageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_m0016" />

    <!-- 分段：选中项是白色滑块，selected 状态与点击由 PluginFragment 投影。 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="18dp" android:background="@drawable/bg_plugin_segment_track" android:orientation="horizontal" android:padding="4dp">
        <TextView android:id="@+id/btnMarket" style="@style/ShellSegment" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_plugin_segment_tab" android:text="@string/ui_m0133" />
        <TextView android:id="@+id/btnInstalled" style="@style/ShellSegment" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_plugin_segment_tab" android:text="@string/ui_m0135" />
    </LinearLayout>

    <LinearLayout android:id="@+id/pluginWebsiteSection" style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
        <LinearLayout android:id="@+id/btnPluginWebsite" style="@style/ShellRow" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView style="@style/ShellRowIcon" android:layout_width="@dimen/shell_row_icon" android:layout_height="@dimen/shell_row_icon" android:contentDescription="@null" android:src="@drawable/ic_plugins" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_community" />
                <TextView style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui2_community_sub" />
            </LinearLayout>
            <ImageView android:layout_width="@dimen/shell_row_chevron" android:layout_height="@dimen/shell_row_chevron" android:contentDescription="@null" android:src="@drawable/ic_ui2_chevron" app:tint="@color/shell_text_muted" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/pluginMarketCard" style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/shell_card_pad">
        <TextView style="@style/ShellCardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_from_link" />
        <LinearLayout android:id="@+id/pluginLinkSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/ui2_plugin_link" />
            <EditText android:id="@+id/appbar_github_input" style="@style/ShellInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:drawableStart="@drawable/ic_ui_link" android:drawablePadding="12dp" android:hint="@string/ui_m0137" android:imeOptions="actionGo" android:importantForAutofill="no" android:inputType="textUri" android:singleLine="true" />
            <TextView android:id="@+id/pluginLinkHint" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/btnPluginPaste" style="@style/ShellSecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableStart="@drawable/ic_ui_copy" android:drawablePadding="8dp" android:text="@string/ui_m0179" />
                <TextView android:id="@+id/btnPluginInstall" style="@style/ShellPrimaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/ui2_resolve" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 已安装筛选：标题 + 检测插件、搜索、只看自己装的、计数、排序 / 检查更新收进同一张 ShellCard。 -->
    <LinearLayout android:id="@+id/installedControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:visibility="gone">
        <LinearLayout style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/shell_card_pad">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView style="@style/ShellCardTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui2_installed" />
                <TextView android:id="@+id/btnRefresh" style="@style/ShellSecondaryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_plugin_scan" android:drawablePadding="6dp" android:minHeight="44dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/ui_m0159" />
            </LinearLayout>

            <EditText android:id="@+id/pluginSearch" style="@style/ShellInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:drawableStart="@drawable/ic_ui_search" android:drawablePadding="12dp" android:hint="@string/ui_m0138" android:imeOptions="actionDone" android:inputType="text" android:singleLine="true" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                <CheckBox android:id="@+id/chkHideBuiltin" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/shell_accent" android:minHeight="44dp" android:text="@string/ui_m0081" android:textColor="@color/shell_text_secondary" android:textSize="13sp" />
                <Button android:id="@+id/btnSort" style="@style/ShellSecondaryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:drawableEnd="@drawable/ic_ui_chevron" android:drawablePadding="4dp" android:text="@string/plugin_sort_az" android:textSize="13sp" />
            </LinearLayout>

            <TextView android:id="@+id/pluginCount" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />

            <Button android:id="@+id/btnPluginUpdates" style="@style/ShellSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/ui_m0018" android:textColor="@color/shell_accent" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <Button android:id="@+id/btnPluginDownloadSource" style="@style/ShellSecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="13sp" />
        <ImageButton android:id="@+id/btnPluginDownloadInfo" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:background="@drawable/bg_plugin_info" android:contentDescription="@string/ui_m0134" android:padding="10dp" android:src="@drawable/ic_plugin_info" app:tint="@color/shell_text_secondary" />
    </LinearLayout>

    <com.deepseekharness.app.ui.PluginTaskProgress android:id="@+id/pluginBusy" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="10dp" android:importantForAccessibility="yes" android:visibility="gone" />

    <TextView android:id="@+id/statusText" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" android:clickable="true" android:contentDescription="@string/ui_m0134" android:focusable="true" android:gravity="center_vertical" android:maxLines="2" android:minHeight="44dp" android:paddingTop="4dp" android:paddingBottom="4dp" />

    <Button android:id="@+id/btnCancelPluginTask" style="@style/ShellTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui_m0079" android:visibility="gone" />
</LinearLayout>
