<?xml version='1.0' encoding='utf-8'?>
<!--
  运行配置（UI v5）：页面大标题 + 分组标签 + shell_page 卡片 / 行 / 输入 / 按钮。
  - 全部既有 id、MaterialSwitch / EditText / DshaSelectView 类型与监听保持不变；
  - 端口自动 / 固定仍由 config_automatic_port 这个 MaterialSwitch 驱动（v5 行内开关形态），
    不改绑定逻辑，也不引入仅作装饰的假分段；
  - 文案全部复用现有 @string，不新增中文串。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/shell_bg">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:background="@color/shell_bg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/shell_page_pad" android:paddingEnd="@dimen/shell_page_pad" android:paddingTop="@dimen/shell_page_top" android:paddingBottom="@dimen/shell_page_bottom">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                  <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="14dp" android:background="@drawable/bg_launch_tile" android:importantForAccessibility="no"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_settings" app:tint="@color/shell_accent" /></FrameLayout>
                  <TextView style="@style/ShellPageTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui2_runtime_config" />
                </LinearLayout>
                <TextView android:id="@+id/config_page_hint" style="@style/ShellPageDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui2_config_sub" />
                <TextView android:drawableStart="@drawable/ic_section_network" style="@style/ShellSectionIconLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/ui2_network_runtime" />
                <LinearLayout style="@style/ShellGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_proroot" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0054" android:visibility="gone" />
                    <com.deepseekharness.app.ui.DshaSelectView android:id="@+id/config_runtime_choice" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_shell_input" android:paddingStart="12dp" android:paddingEnd="12dp" />
                    <View style="@style/ShellDivider" android:layout_marginStart="0dp" android:layout_marginTop="12dp" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_automatic_port" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/build190_auto_port" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/config_port" style="@style/ShellRowSub" android:layout_marginTop="12dp" android:text="@string/ui2_port_preferred" />
                    <EditText android:id="@+id/config_port" style="@style/ShellInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:importantForAutofill="no" android:inputType="number" />
                    <TextView android:id="@+id/config_port_hint" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ui2_port_hint" />
                    <Button android:id="@+id/config_restore_port_drafts" style="@style/ShellTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:text="@string/build190_restore_port_drafts" />
                    <View style="@style/ShellDivider" android:layout_marginStart="0dp" android:layout_marginTop="8dp" />
                    <TextView style="@style/ShellCardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/config_dns_choice" android:text="@string/ui2_dns" />
                    <RadioGroup android:id="@+id/config_dns_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone">
                        <RadioButton android:id="@+id/dns_auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="@string/dns_auto" />
                        <RadioButton android:id="@+id/dns_ipv4" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="@string/dns_ipv4" />
                        <RadioButton android:id="@+id/dns_native" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="@string/dns_native" />
                    </RadioGroup>
                    <com.deepseekharness.app.ui.DshaSelectView android:id="@+id/config_dns_choice" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_shell_input" android:paddingStart="12dp" android:paddingEnd="12dp" />
                    <View style="@style/ShellDivider" android:layout_marginStart="0dp" android:layout_marginTop="12dp" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_lan_mode" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0063" />
                    <Button android:id="@+id/config_lan_password" style="@style/ShellTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/lan_password_button" />
                    <TextView android:id="@+id/config_lan_password_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/config_lan_hint" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_lan_unencrypted" />
                </LinearLayout>
                <TextView android:drawableStart="@drawable/ic_section_compat" style="@style/ShellSectionIconLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/ui2_runtime_compat" />
                <LinearLayout style="@style/ShellGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_static_loader" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/alpha_static_loader" />
                    <View style="@style/ShellDivider" android:layout_marginStart="0dp" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_no_seccomp" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/alpha_no_seccomp" />
                </LinearLayout>
                <TextView android:drawableStart="@drawable/ic_section_display" style="@style/ShellSectionIconLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/ui2_display" />
                <LinearLayout style="@style/ShellGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_desktop_mode" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0057" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_gecko_core" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0055" android:visibility="gone" />
                    <com.deepseekharness.app.ui.DshaSelectView android:id="@+id/config_core_choice" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_shell_input" android:paddingStart="12dp" android:paddingEnd="12dp" />
                    <TextView android:id="@+id/config_gecko_hint" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_m0118" />
                    <View style="@style/ShellDivider" android:layout_marginStart="0dp" android:layout_marginTop="8dp" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_picture_in_picture" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/picture_in_picture_enable" />
                    <LinearLayout android:id="@+id/config_picture_in_picture_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="56dp" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/picture_in_picture_title" />
                            <TextView android:id="@+id/config_picture_in_picture_status" style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/picture_in_picture_disabled" />
                        </LinearLayout>
                        <ImageView android:layout_width="@dimen/shell_row_chevron" android:layout_height="@dimen/shell_row_chevron" android:layout_marginStart="8dp" android:contentDescription="@null" android:src="@drawable/ic_ui2_chevron" app:tint="@color/shell_text_muted" />
                    </LinearLayout>
                    <View style="@style/ShellDivider" android:layout_marginStart="0dp" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_check_update" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0089" />
                </LinearLayout>
                <TextView android:drawableStart="@drawable/ic_section_floating" style="@style/ShellSectionIconLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/ui2_floating" />
                <LinearLayout style="@style/ShellGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_overlay_stream" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0121" />
                    <View style="@style/ShellDivider" android:layout_marginStart="0dp" />
                    <LinearLayout android:id="@+id/config_overlay_style" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal">
                        <ImageView style="@style/ShellRowIcon" android:layout_width="@dimen/shell_row_icon" android:layout_height="@dimen/shell_row_icon" android:contentDescription="@null" android:src="@drawable/ic_ui_chat" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_floating_settings" />
                            <TextView style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui2_floating_settings_sub" />
                        </LinearLayout>
                        <ImageView android:layout_width="@dimen/shell_row_chevron" android:layout_height="@dimen/shell_row_chevron" android:contentDescription="@null" android:src="@drawable/ic_ui2_chevron" app:tint="@color/shell_text_muted" />
                    </LinearLayout>
                </LinearLayout>
                <Button android:id="@+id/config_workspace_entry" style="@style/ShellSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/ui_m0126" />
                <TextView android:id="@+id/config_repo_link" style="@style/ShellFooter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/app_name" />
                <TextView android:id="@+id/config_adv_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:visibility="gone" />
                <LinearLayout android:id="@+id/config_adv_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/config_save" style="@style/ShellPrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/shell_page_pad" android:layout_marginEnd="@dimen/shell_page_pad" android:layout_marginTop="10dp" android:layout_marginBottom="16dp" android:text="@string/ui_m0002" />
</LinearLayout>
