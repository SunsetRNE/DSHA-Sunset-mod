<?xml version='1.0' encoding='utf-8'?>
<!--
  自检与诊断（UI v5）：顶栏返回 + 页面标题 + 分组标签 + shell_page 卡片 / 行 / 按钮。
  - 全部既有 id、TextView / EditText / Button 类型与 DiagnosticActivity 绑定保持不变；
  - diagnostic_results 仍由 CardPage.entry 动态填充，行样式由 CardPage 自己提供；
  - 文案全部复用现有 @string。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/shell_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="12dp" android:gravity="center_vertical">
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/diagnostic_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_ui_back" android:contentDescription="@string/ui_m0201" app:tint="@color/shell_text" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:includeFontPadding="false" android:text="@string/ui2_diagnostics" android:textColor="@color/shell_text" android:textSize="@dimen/shell_title_text" android:textStyle="bold" />
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/shell_page_pad" android:paddingEnd="@dimen/shell_page_pad" android:paddingTop="@dimen/shell_page_top" android:paddingBottom="@dimen/shell_page_bottom">
      <TextView style="@style/ShellPageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_diagnostics" />
      <TextView style="@style/ShellPageDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui2_diagnostics_intro" />

      <LinearLayout style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
        <TextView android:id="@+id/diagnostic_headline" style="@style/ShellCardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui134_check_ready" />
        <TextView android:id="@+id/diagnostic_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="" />
        <Button android:id="@+id/diagnostic_refresh" style="@style/ShellSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/ui_m0209" />
      </LinearLayout>

      <TextView style="@style/ShellSectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/ui134_results" />
      <LinearLayout android:id="@+id/diagnostic_results" style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="4dp" android:paddingEnd="14dp" android:paddingBottom="4dp" />
      <TextView android:id="@+id/diagnostic_report" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:paddingEnd="8dp" android:textIsSelectable="true" android:visibility="gone" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <Button android:id="@+id/diagnostic_copy" style="@style/ShellSecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/ui_m0103" />
        <Button android:id="@+id/diagnostic_export" style="@style/ShellSecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:minHeight="48dp" android:text="@string/ui_m0109" />
      </LinearLayout>

      <TextView style="@style/ShellSectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/ui134_start_records" />
      <LinearLayout style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/diagnostic_history" style="@style/ShellRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp">
          <ImageView style="@style/ShellRowIcon" android:layout_width="@dimen/shell_row_icon" android:layout_height="@dimen/shell_row_icon" android:contentDescription="@null" android:src="@drawable/ic_recovery_document" />
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui134_recent_startups" />
            <TextView style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui134_recent_startups_sub" />
          </LinearLayout>
          <ImageView android:layout_width="@dimen/shell_row_chevron" android:layout_height="@dimen/shell_row_chevron" android:contentDescription="@null" android:src="@drawable/ic_ui2_chevron" app:tint="@color/shell_text_muted" />
        </LinearLayout>
        <View style="@style/ShellDivider" />
        <LinearLayout android:id="@+id/diagnostic_recovery" style="@style/ShellRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp">
          <ImageView style="@style/ShellRowIcon" android:layout_width="@dimen/shell_row_icon" android:layout_height="@dimen/shell_row_icon" android:contentDescription="@null" android:src="@drawable/ic_ui2_box" />
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui134_startup_recovery" />
            <TextView style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui134_startup_recovery_sub" />
          </LinearLayout>
          <ImageView android:layout_width="@dimen/shell_row_chevron" android:layout_height="@dimen/shell_row_chevron" android:contentDescription="@null" android:src="@drawable/ic_ui2_chevron" app:tint="@color/shell_text_muted" />
        </LinearLayout>
      </LinearLayout>

      <TextView style="@style/ShellSectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/ui2_error_logs" />
      <LinearLayout style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
        <TextView android:id="@+id/diagnostic_logs_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="44dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="@color/shell_accent" />
        <Button android:id="@+id/diagnostic_logs_download" style="@style/ShellSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/ui_m0047" />
        <Button android:id="@+id/diagnostic_logs_save_as" style="@style/ShellTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:text="@string/ui_m0080" />
      </LinearLayout>

      <TextView style="@style/ShellSectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/ui2_troubleshooting" />
      <LinearLayout style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
        <Button android:id="@+id/diagnostic_repair" style="@style/ShellSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_m0060" />
        <Button android:id="@+id/diagnostic_plugins" style="@style/ShellTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:text="@string/ui_m0013" />
      </LinearLayout>

      <TextView style="@style/ShellSectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/ui2_reproduction" />
      <EditText android:id="@+id/diagnostic_steps" style="@style/ShellInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:hint="@string/ui_m0182" android:inputType="textMultiLine" android:maxLength="2000" android:minHeight="96dp" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>
