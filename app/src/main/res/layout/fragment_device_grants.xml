<?xml version='1.0' encoding='utf-8'?>
<!--
  设备能力授权（压缩版，对应 v3 预览）：
  - 顶部概览独立成固定头部 grants_header，不随内容滚动；页面大标题交给顶栏，说明收进概览后的 ⓘ。
  - grants_columns 内两栏：手机只用 grants_col_start（顺序：全局 / 通道 / 屏幕 / 系统 / 敏感）；
    内容宽 ≥640dp 时 DeviceGrantsFragment 把屏幕操作与敏感能力移到 grants_col_end。
    按 Fragment 实际宽度判断，平板设置页左右分栏时同样适用。
  - FullPermissionControls 追加到 grants_global_slot；其余既有 id / 点击 / 二次确认 / 状态绑定保持。
  - Root 档位与屏幕确认方式由 Fragment 生成分段选择，注入 device_root_modes 与 screen_policy_cards。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/grants_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/shell_bg" android:orientation="vertical">

  <!-- ===== 固定概览头部（胶囊由 Fragment 生成） ===== -->
  <LinearLayout android:id="@+id/grants_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_grants_header" android:elevation="2dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/grants_page_pad" android:paddingTop="4dp" android:paddingEnd="6dp" android:paddingBottom="10dp" />

  <ScrollView android:id="@+id/grants_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:id="@+id/grants_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/grants_page_pad" android:paddingTop="@dimen/grants_page_top" android:paddingEnd="@dimen/grants_page_pad" android:paddingBottom="@dimen/shell_page_bottom">
      <LinearLayout android:id="@+id/grants_columns" android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:orientation="horizontal">

        <LinearLayout android:id="@+id/grants_col_start" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

          <!-- 全局权限：标签 + FullPermissionControls 注入的卡片 -->
          <LinearLayout android:id="@+id/grants_section_global" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/grants_global_label" style="@style/ShellSectionIconLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/grants_section_margin" android:drawableStart="@drawable/ic_section_global" />
            <LinearLayout android:id="@+id/grants_global_slot" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
          </LinearLayout>

          <!-- 设备执行通道：Root / Shizuku / ADB 合并为一张卡，长说明收进标签旁 ⓘ -->
          <LinearLayout android:id="@+id/grants_section_channels" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/grants_section_gap" android:orientation="vertical">
            <TextView android:id="@+id/grants_channels_label" style="@style/ShellSectionIconLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/grants_section_margin" android:drawableStart="@drawable/ic_section_channels" android:text="@string/ui2_device_channels" />
            <LinearLayout style="@style/ShellGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/grants_card_pad_h" android:paddingTop="@dimen/grants_card_pad_v" android:paddingEnd="@dimen/grants_card_pad_h" android:paddingBottom="10dp">
              <!-- Root：开关 / 状态 + 验证 / 档位分段 / 警告 -->
              <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_root_shell" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0062" />
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/device_root_status" style="@style/ShellStatusText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_action_plain" android:ellipsize="end" android:maxLines="2" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/device_checking" />
                <Button android:id="@+id/device_root_verify" style="@style/ShellTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" />
              </LinearLayout>
              <RadioGroup android:id="@+id/device_root_modes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_plugin_segment_track" android:orientation="horizontal" android:padding="3dp" />
              <TextView android:id="@+id/device_root_policy_warning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:background="@drawable/bg_root_policy_warning" android:drawableStart="@drawable/ic_section_warning" android:drawablePadding="8dp" android:drawableTint="@color/shell_bad" android:includeFontPadding="false" android:lineSpacingExtra="2dp" android:padding="10dp" android:textColor="@color/shell_bad" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
              <TextView android:id="@+id/config_guard_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:visibility="gone" />

              <View style="@style/ShellDivider" android:layout_marginStart="0dp" android:layout_marginTop="10dp" />

              <!-- Shizuku / Stellar：标题 + 验证或授权 + 打开 / 状态 -->
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="48dp" android:orientation="horizontal">
                <TextView android:id="@+id/device_shizuku_title" style="@style/ShellRowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="@string/ui_brand_shizuku" />
                <Button android:id="@+id/workspace_shizuku_auth" style="@style/ShellTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" />
                <Button android:id="@+id/device_shizuku_open" style="@style/ShellTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" />
              </LinearLayout>
              <TextView android:id="@+id/workspace_shizuku_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_action_plain" android:ellipsize="end" android:maxLines="2" android:paddingBottom="4dp" android:text="@string/ui_m0039" />

              <View style="@style/ShellDivider" android:layout_marginStart="0dp" android:layout_marginTop="8dp" />

              <!-- ADB：开关 / 状态 + 配对 -->
              <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_adb_enable" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" />
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/config_adb_status" style="@style/ShellStatusText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_action_plain" android:ellipsize="end" android:maxLines="2" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/ui_m0030" />
                <Button android:id="@+id/config_adb_pair" style="@style/ShellTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" />
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>

          <!-- 屏幕操作：标签行带「撤销」；状态 / 设置 / 暂停 / 确认方式分段 -->
          <LinearLayout android:id="@+id/grants_section_screen" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/grants_section_gap" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
              <TextView style="@style/ShellSectionIconLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableStart="@drawable/ic_section_screen" android:text="@string/computer_use_title" />
              <Button android:id="@+id/screen_revoke" style="@style/ShellTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="36dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textColor="@color/shell_bad" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/screen_card" style="@style/ShellGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/grants_card_pad_h" android:paddingTop="8dp" android:paddingEnd="@dimen/grants_card_pad_h" android:paddingBottom="10dp">
              <TextView android:id="@+id/computer_use_hint" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" />
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="44dp" android:orientation="horizontal">
                <TextView android:id="@+id/config_a11y_status" style="@style/ShellRowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:accessibilityLiveRegion="polite" android:text="@string/device_checking" android:textSize="13sp" />
                <Button android:id="@+id/screen_resetup" style="@style/ShellTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:visibility="gone" />
              </LinearLayout>
              <Button android:id="@+id/computer_use_accessibility" style="@style/ShellPrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="@string/ui134_screen_setup" />
              <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/screen_pause" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" />
              <View style="@style/ShellDivider" android:layout_marginStart="0dp" android:layout_marginTop="2dp" />
              <TextView android:id="@+id/screen_policy_label" style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="13sp" />
              <LinearLayout android:id="@+id/screen_policy_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
              <TextView android:id="@+id/screen_policy_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/screen_virtual_group" style="@style/ShellGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone">
              <LinearLayout android:id="@+id/screen_virtual_row" style="@style/ShellRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingStart="@dimen/grants_card_pad_h" android:paddingTop="8dp" android:paddingEnd="@dimen/grants_card_pad_h" android:paddingBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                  <TextView android:id="@+id/screen_virtual_title" style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
                  <TextView android:id="@+id/screen_virtual_sub" style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" />
                </LinearLayout>
                <ImageView android:layout_width="@dimen/shell_row_chevron" android:layout_height="@dimen/shell_row_chevron" android:layout_marginStart="8dp" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ic_ui2_chevron" app:tint="@color/shell_text_muted" />
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>

          <!-- 系统权限：两行可点，状态 / 说明作为副标题 -->
          <LinearLayout android:id="@+id/grants_section_system" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/grants_section_gap" android:orientation="vertical">
            <TextView style="@style/ShellSectionIconLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/grants_section_margin" android:drawableStart="@drawable/ic_section_system" android:text="@string/ui2_system_permissions" />
            <LinearLayout style="@style/ShellGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
              <LinearLayout android:id="@+id/config_all_files" style="@style/ShellRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingStart="@dimen/grants_card_pad_h" android:paddingTop="8dp" android:paddingEnd="@dimen/grants_card_pad_h" android:paddingBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                  <TextView style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/device_open_access" />
                  <TextView android:id="@+id/config_all_files_status" style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/device_checking" />
                </LinearLayout>
                <ImageView android:layout_width="@dimen/shell_row_chevron" android:layout_height="@dimen/shell_row_chevron" android:layout_marginStart="8dp" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ic_ui2_chevron" app:tint="@color/shell_text_muted" />
              </LinearLayout>
              <View style="@style/ShellDivider" android:layout_marginStart="@dimen/grants_card_pad_h" />
              <LinearLayout android:id="@+id/config_battery_opt" style="@style/ShellRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingStart="@dimen/grants_card_pad_h" android:paddingTop="8dp" android:paddingEnd="@dimen/grants_card_pad_h" android:paddingBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                  <TextView style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_m0191" />
                  <TextView android:id="@+id/config_battery_opt_hint" style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="3" android:text="@string/ui_m0084" />
                </LinearLayout>
                <ImageView android:layout_width="@dimen/shell_row_chevron" android:layout_height="@dimen/shell_row_chevron" android:layout_marginStart="8dp" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ic_ui2_chevron" app:tint="@color/shell_text_muted" />
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>

          <!-- 独立敏感能力 -->
          <LinearLayout android:id="@+id/grants_section_sensitive" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/grants_section_gap" android:orientation="vertical">
            <TextView style="@style/ShellSectionIconLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/grants_section_margin" android:drawableStart="@drawable/ic_section_sensitive" android:text="@string/ui2_sensitive" />
            <LinearLayout style="@style/ShellGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/grants_card_pad_h" android:paddingTop="@dimen/grants_card_pad_v" android:paddingEnd="@dimen/grants_card_pad_h" android:paddingBottom="@dimen/grants_card_pad_v">
              <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/device_sms" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0171" />
              <TextView android:id="@+id/device_sms_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp" android:text="@string/device_checking" />
              <View style="@style/ShellDivider" android:layout_marginStart="0dp" />
              <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_cap_location" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0066" />
              <View style="@style/ShellDivider" android:layout_marginStart="0dp" />
              <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_cap_sensors" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0053" />
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>

        <!-- 右栏：双栏时放屏幕操作与敏感能力；手机上为空且隐藏 -->
        <LinearLayout android:id="@+id/grants_col_end" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/grants_column_gap" android:layout_weight="1" android:orientation="vertical" android:visibility="gone" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
