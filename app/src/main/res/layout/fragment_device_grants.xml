<?xml version='1.0' encoding='utf-8'?>
<!--
  设备能力授权（UI v5）：页面大标题 + 分组标签 + shell_page 卡片 / 行 / 开关 / 按钮。
  - 根节点仍是 ScrollView，首个子节点仍是 LinearLayout（DeviceGrantsFragment 与
    FullPermissionControls 直接按下标注入控件）；
  - 所有既有 id / 类型 / 点击 / 二次确认 / 动态状态文本绑定保持不变；
  - 短信、位置、传感器仍是 MaterialSwitch；状态框统一 bg_shell_status。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:background="@color/shell_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/shell_page_pad" android:paddingEnd="@dimen/shell_page_pad" android:paddingTop="@dimen/shell_page_top" android:paddingBottom="@dimen/shell_page_bottom">
    <TextView style="@style/ShellPageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_device_grants" />
    <TextView android:id="@+id/grants_page_hint" style="@style/ShellPageDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="@string/ui2_grants_sub" />

    <TextView style="@style/ShellSectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/ui2_device_channels" />

    <LinearLayout style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_root_shell" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0062" />
      <TextView android:id="@+id/device_root_hint" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui134_root_hint" />
      <TextView android:id="@+id/device_root_policy" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_shell_status" android:padding="12dp" android:text="@string/device_checking" android:textColor="@color/shell_text_secondary" />
      <Button android:id="@+id/device_root_policy_change" style="@style/ShellSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/ui_m9024" />
      <TextView android:id="@+id/device_root_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_shell_status" android:ellipsize="end" android:maxLines="2" android:minHeight="0dp" android:padding="12dp" android:text="@string/device_checking" android:textColor="@color/shell_text_secondary" />
      <TextView android:id="@+id/config_guard_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:visibility="gone" />
      <Button android:id="@+id/device_root_verify" style="@style/ShellSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/ui_m0170" />
    </LinearLayout>

    <LinearLayout style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
      <TextView android:id="@+id/device_shizuku_title" style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_brand_shizuku" />
      <TextView android:id="@+id/device_shizuku_hint" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui134_shizuku_hint" />
      <TextView android:id="@+id/workspace_shizuku_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_shell_status" android:ellipsize="end" android:maxLines="4" android:minHeight="0dp" android:padding="12dp" android:text="@string/ui_m0039" android:textColor="@color/shell_text_secondary" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/workspace_shizuku_auth" style="@style/ShellSecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/ui_m0015" />
        <Button android:id="@+id/device_shizuku_open" style="@style/ShellTextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:minHeight="48dp" android:text="@string/ui_m0125" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_adb_enable" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0090" />
      <TextView android:id="@+id/device_adb_hint" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui134_adb_hint" />
      <TextView android:id="@+id/config_adb_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_shell_status" android:ellipsize="end" android:maxLines="2" android:minHeight="0dp" android:padding="12dp" android:text="@string/ui_m0030" android:textColor="@color/shell_text_secondary" />
      <Button android:id="@+id/config_adb_pair" style="@style/ShellSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/ui_m0031" />
    </LinearLayout>

    <TextView style="@style/ShellSectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/computer_use_title" />
    <LinearLayout style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
      <TextView android:id="@+id/computer_use_hint" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" />
      <Button android:id="@+id/computer_use_accessibility" style="@style/ShellSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/ui134_screen_setup" />
      <TextView android:id="@+id/config_a11y_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_shell_status" android:padding="12dp" android:text="@string/device_checking" />
    </LinearLayout>

    <TextView style="@style/ShellSectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/ui2_system_permissions" />
    <LinearLayout style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:id="@+id/config_all_files" style="@style/ShellRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp">
        <TextView style="@style/ShellRowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/device_open_access" />
        <ImageView android:layout_width="@dimen/shell_row_chevron" android:layout_height="@dimen/shell_row_chevron" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ic_ui2_chevron" app:tint="@color/shell_text_muted" />
      </LinearLayout>
      <View style="@style/ShellDivider" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/shell_row_pad_h" android:paddingEnd="@dimen/shell_row_pad_h" android:paddingBottom="@dimen/shell_row_pad_v">
        <TextView android:id="@+id/config_all_files_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/device_checking" />
        <TextView android:id="@+id/config_battery_opt_hint" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui_m0084" />
        <Button android:id="@+id/config_battery_opt" style="@style/ShellSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/ui_m0191" />
      </LinearLayout>
    </LinearLayout>

    <TextView style="@style/ShellSectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:text="@string/ui2_sensitive" />
    <LinearLayout style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/device_sms" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0171" />
      <TextView android:id="@+id/device_sms_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_shell_status" android:padding="12dp" android:text="@string/device_checking" />
      <View style="@style/ShellDivider" android:layout_marginStart="0dp" android:layout_marginTop="8dp" />
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_cap_location" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0066" />
      <View style="@style/ShellDivider" android:layout_marginStart="0dp" />
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_cap_sensors" style="@style/ShellSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0053" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
