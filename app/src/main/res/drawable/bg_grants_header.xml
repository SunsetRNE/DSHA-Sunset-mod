<?xml version="1.0" encoding="utf-8"?>
<!-- 授权页固定概览头部：与顶栏同底色衔接，只露出底边细线与下圆角，和下方滚动内容分离。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="-1dp" android:right="-1dp" android:top="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shell_surface" />
            <corners android:bottomLeftRadius="16dp" android:bottomRightRadius="16dp" />
            <stroke android:width="1dp" android:color="@color/shell_line_strong" />
        </shape>
    </item>
</layer-list>
