<?xml version="1.0" encoding="utf-8"?>
<!-- v5 手机底部悬浮胶囊：圆角、1dp 描边。DSHA-Mod：底色改用玻璃 token，
     壁纸才能从胶囊里透出来（日夜跟随 appbar_glass 自动切换）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/appbar_glass" />
    <stroke
        android:width="1dp"
        android:color="@color/shell_line_strong" />
    <corners android:radius="22dp" />
</shape>
