<?xml version="1.0" encoding="utf-8"?>
<!--
  主页编辑态下的底栏：同样是悬浮胶囊，但描边改成虚线并带一点强调色，
  告诉用户「这一条现在可以直接拖」。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/shell_nav_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/shell_accent"
        android:dashWidth="6dp"
        android:dashGap="4dp" />
    <corners android:radius="22dp" />
</shape>
