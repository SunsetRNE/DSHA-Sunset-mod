<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item android:id="@android:id/mask"><shape><solid android:color="#FFFFFFFF" /><corners android:radius="@dimen/radius_small" /></shape></item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/shell_accent_soft" />
                    <corners android:radius="@dimen/radius_small" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
