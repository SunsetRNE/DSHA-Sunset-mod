<?xml version="1.0" encoding="utf-8"?>
<!--
  UI v5 方案 A：设置子页分组。原型详情页是平铺的分隔线分组而不是浮起卡片：
  透明底 + 1dp shell_line 细边 + 小圆角，行之间仍用 ShellDivider。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/card_glass" />
    <corners android:radius="14dp" />
    <!-- 玻璃底和页面底几乎同色时，靠这 1dp 才能看出「这是一组」 -->
    <stroke android:width="1dp" android:color="@color/shell_line_strong" />
</shape>
