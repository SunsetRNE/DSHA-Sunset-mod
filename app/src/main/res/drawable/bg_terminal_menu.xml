<?xml version="1.0" encoding="utf-8"?>
<!-- 终端悬浮球：86% 玻璃底（shell_nav_bg）+ 1dp shell_line 描边 + 主题涟漪，跟随明暗主题。
     图标由 TerminalFloatingMenu 以 shell_accent 着色；底色不再用终端面板纯色。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/shell_nav_ripple">
    <item><shape android:shape="oval">
        <solid android:color="@color/shell_nav_bg" />
        <stroke android:width="1dp" android:color="@color/shell_line_strong" />
    </shape></item>
</ripple>
