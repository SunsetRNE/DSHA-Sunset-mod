    <color name="terminal_panel_card">#F7F9FD</color>
    <color name="logo_top">#E8EFFF</color>

    <!-- 按压涟漪：主色低透明度，浅色底上淡淡一层；叠加 raised 后主色文字仍须保持 4.5:1。 -->
    <color name="ripple">#141E50D0</color>
    <color name="primary_ripple">#1FFFFFFF</color>
    <color name="error_on">#FFFFFF</color>
    <!-- 禁用态：按钮变灰 + 文字降到可读下限（不可点却外观照旧最让人困惑） -->
    <color name="disabled">#E7EDF6</color>
    <!-- 状态色的浅底（用于状态条/标签背景，不刺眼） -->
    <color name="err_bg">#14C45A5A</color>
</resources>
