{
  "schema": 1,
  "modules": [
    {
      "path": ":app",
      "directory": "app",
      "kind": "android-application",
      "sourceSets": ["main", "standard", "debug", "androidTest", "test", "deviceAudit"],
      "formatSourceSets": ["main", "standard", "debug", "androidTest", "test"],
      "testSourceSets": ["test"],
      "testTask": "testStandardDebugUnitTest"
    },
    {
      "path": ":core:policy",
      "directory": "core/policy",
      "kind": "jvm",
      "sourceSets": ["main", "test"],
      "formatSourceSets": ["main", "test"],
      "testSourceSets": ["test"],
      "testTask": "test"
    }
  ]
}
